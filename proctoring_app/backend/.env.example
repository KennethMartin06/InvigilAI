# ── Database ──────────────────────────────────────────────────────────────────
# Production (Railway / Render / Fly.io):
#   Copy the connection string from your PostgreSQL add-on dashboard.
#   Railway format:  postgresql://postgres:<password>@<host>.railway.app:5432/railway
#   Render format:   postgresql://<user>:<password>@<host>.render.com/proctordb
DATABASE_URL=postgresql://postgres:password@localhost:5432/proctordb

# Local development (SQLite fallback — no extra setup needed):
# DATABASE_URL=sqlite:///./proctoring.db

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# ── ML Models ─────────────────────────────────────────────────────────────────
MODEL_PATH=../cheating_detection/models/mlp_model.pth
SCALER_PATH=../cheating_detection/models/scaler.joblib
CHEATING_THRESHOLD=0.70

# ── File storage ──────────────────────────────────────────────────────────────
# On Railway/Render use a mounted volume or S3; for local dev ./uploads is fine.
UPLOAD_DIR=./uploads

# ── CORS ──────────────────────────────────────────────────────────────────────
# Local dev: http://localhost:5173
# Production: https://your-app.vercel.app
CORS_ORIGINS=http://localhost:5173
